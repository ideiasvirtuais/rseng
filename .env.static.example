# Configuração do PACOTE ESTÁTICO UNIVERSAL (opcional — tudo tem default sensato)
# Copie para .env.local se for publicar fora do domínio oficial.
#
# 1) Domínio canônico (SEO: sitemap, robots, OG). Fora do oficial, o CNAME
#    é omitido automaticamente e o SEO usa este valor.
# SITE_URL=https://meudominio.com
# VITE_SITE_URL=https://meudominio.com
#
# 2) Subpasta (GitHub Pages de projeto, /staging, addon de cPanel...).
#    Raiz = "/". Subpasta = "/minha-pasta/".
# BASE_PATH=/
# VITE_BASE_PATH=/
#
# 3) Diretório de saída / artefato
# STATIC_OUT_DIR=dist/client
# STATIC_ZIP=dist/rseng-static.zip
#
# 4) FTP continua OPCIONAL (KingHost é só uma das opções — veja .env.ftp.example)
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=
